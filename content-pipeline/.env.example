# ── Required ──────────────────────────────────────────────────────────────
# DeepSeek API key — https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# ── Optional (enables web-search topic research) ──────────────────────────
# Exa API key — https://exa.ai/  (neural web search, surfaces Threads/IG content)
# Without this, the pipeline falls back to Reddit-only research.
EXA_API_KEY=...
